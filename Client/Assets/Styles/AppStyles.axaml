<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <!-- Add Controls for Previewer Here -->
    <Border Padding="20" Background="{DynamicResource PrimaryBgColor}">
      <TextBlock Classes="pagetitle" Text="Test" Foreground="{DynamicResource PrimaryTextColor}" />
    </Border>
  </Design.PreviewWith>
  <!-- Add Styles Here -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}" />
    <Setter Property="Background" Value="{DynamicResource PrimaryBgColor}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}" />
  </Style>

  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="35" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="LineSpacing" Value="10" />
  </Style>
  <Style Selector="TextBlock.homeViewTitle">
    <Setter Property="FontSize" Value="25" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="LineSpacing" Value="10" />
  </Style>
  <Style Selector="Label">
    <Setter Property="FontSize" Value="20"/>
  </Style>

  <Style Selector="Label.form">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Padding" Value="0 5" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="MaxWidth" Value="300" />
    <Setter Property="MinWidth" Value="300" />
    <Setter Property="Background" Value="#C5EDC6E5" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.primBtn">
    <Setter Property="Background" Value="{DynamicResource PrimaryBgColor}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}" />
    <Setter Property="Padding" Value="20 30" />

  </Style>


</Styles>
