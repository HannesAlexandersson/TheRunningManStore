<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <!-- Add Controls for Previewer Here -->
    <Border Padding="20" Background="{DynamicResource PrimaryBgColor}">
      <TextBlock Classes="pagetitle" Text="Test" Foreground="{DynamicResource PrimaryTextColor}" />
    </Border>
  </Design.PreviewWith>
  <!-- Add Styles Here -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}" />
  </Style>

  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="35" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="LineSpacing" Value="10" />
  </Style>

</Styles>
