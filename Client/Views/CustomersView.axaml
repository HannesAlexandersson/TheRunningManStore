<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.CustomersView"
             x:DataType="vm:CustomersViewModel"
             Background="{DynamicResource PrimaryBgColor}"
             Foreground="{DynamicResource PrimaryTextColor}"
             >
  <Design.DataContext>
    <vm:CustomersViewModel></vm:CustomersViewModel>
  </Design.DataContext>
  <StackPanel>
    <TextBlock Classes="pageTitle" FontWeight="Bold" TextDecorations="Underline" Text="{Binding PageTitle}" />
    <Border BorderBrush="white" BorderThickness="0 0 0 2" Padding="0 0 0 5">
      <Grid ColumnDefinitions="230, 175, 175,  *, 60, 60" RowDefinitions="*" HorizontalAlignment="Stretch">
        <Label Grid.Column="0"  FontSize="25" FontWeight="Bold"  Content="Name"  />
        <Label Grid.Column="1" FontSize="25" FontWeight="Bold" Content="Phone" />
        <Label Grid.Column="2" FontSize="25" FontWeight="Bold"  Content="Address"  />
        <Label Grid.Column="3" FontSize="25" FontWeight="Bold" Content="Email" HorizontalAlignment="Right"  />


      </Grid>
    </Border>

    <ItemsControl ItemsSource="{Binding Customers}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="115, 115, 175, 175, *, 60, 60" >
            <Label Grid.Column="0"  Content="{Binding FirstName }" />
            <Label Grid.Column="1"  Content="{Binding LastName }" />
            <Label Grid.Column="2"  Content="{Binding Phone}"  />
            <Label Grid.Column="3"  Content="{Binding AddressLine}" />
            <Label Grid.Column="4"  Content="{Binding Email}" HorizontalAlignment="Right" />
            <Button Grid.Column="5" FontFamily="{DynamicResource IconFont}" Content="&#xE3AE;" Foreground="Green" Background="Transparent" Padding="10 0 0 10" Command="{Binding $parent[UserControl].DataContext.EditCommand}" CommandParameter="{Binding Id}"  />
            <Button Grid.Column="6" FontFamily="{DynamicResource IconFont}" Content="&#xE4F6;" Foreground="Red" Background="Transparent" Padding="10 0 0 10" Command="{Binding  $parent[UserControl].DataContext.DeleteCommand}" CommandParameter="{Binding Id}" />

          </Grid>

        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>

</UserControl>
