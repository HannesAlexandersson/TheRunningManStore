<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.OrdersView"
             x:DataType="vm:OrdersViewModel"
             Background="{DynamicResource PrimaryBgColor}"
             Foreground="{DynamicResource PrimaryTextColor}"
             >
  <Design.DataContext>
    <vm:OrdersViewModel></vm:OrdersViewModel>
  </Design.DataContext>
  <StackPanel>
    <TextBlock Classes="pageTitle" Text="{Binding PageTitle}" />
    <Border BorderBrush="white" BorderThickness="0 0 0 2" Padding="0 0 0 5">
      <Grid ColumnDefinitions="200,  200, *, 60,60" RowDefinitions="*" HorizontalAlignment="Stretch"> <!--add two extra columns with 10 space to fill the extra space-->

      <Label Grid.Column="0" FontSize="20" FontWeight="Bold"  Content="OrderId" HorizontalAlignment="Left" />
        <Label Grid.Column="1" FontSize="25" FontWeight="Bold"  Content="TotalSum" HorizontalAlignment="Right" />
        <Label Grid.Column="3" />
        <Label Grid.Column="4" />
      </Grid>
    </Border>


    <ItemsControl ItemsSource="{Binding Orders}"> <!-- iterative control structure. bind to this list/array/class -->
    <ItemsControl.ItemTemplate> <!--set up template for the iterative data -->
    <DataTemplate>
      <Border
        BorderBrush="white"
        BorderThickness="0,0,0,1"
        Padding="10"
        Margin="0,0,0,5">
        <Grid ColumnDefinitions="100,  *, 200, 60,60">
          <Label Grid.Column="0"  Content="{Binding OrderId}" HorizontalAlignment="Left" />
          <!-- iterate through this orders products -->
          <ItemsControl Grid.Column="1"  ItemsSource="{Binding Products}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="100,100">
                  <Label Grid.Column="0"  Content="{Binding Name}" HorizontalAlignment="Left" />
                  <Label Grid.Column="1"  Content="{Binding Price}" HorizontalAlignment="Left" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- END of inner loop -->
          <Label Grid.Column="1"  Content="{Binding TotalSum}" HorizontalAlignment="Right" /> <!-- Add icons to cast and edit -->
          <Button Grid.Column="3" FontFamily="{DynamicResource IconFont}" Content="&#xE3AE;" Foreground="Green" Background="Transparent" Padding="10 0 0 10" Command="{Binding $parent[UserControl].DataContext.EditCommand}" CommandParameter="{Binding OrderId}" />
          <Button Grid.Column="4" FontFamily="{DynamicResource IconFont}" Content="&#xE4F6;" Foreground="Red" Background="Transparent" Padding="10 0 0 10" Command="{Binding $parent[UserControl].DataContext.DeleteCommand}" CommandParameter="{Binding OrderId}" />

        </Grid>
      </Border>
    </DataTemplate>
    </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
