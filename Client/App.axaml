<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Client"
             x:Class="Client.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <!-- the global data template -->
        <local:ViewLocator>

        </local:ViewLocator>
    </Application.DataTemplates>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="Assets/Styles/AppStyles.axaml"></StyleInclude>
        <StyleInclude Source="Assets/Styles/MenuButtonStyles.axaml"></StyleInclude>
    </Application.Styles>
    <Application.Resources>
        <!--  set up global resources -->
        <SolidColorBrush x:Key="PrimaryTextColor">#eae8e8</SolidColorBrush>
        <!--  <SolidColorBrush x:Key="PrimaryBgColor">#030331</SolidColorBrush> -->
        <SolidColorBrush x:Key="PrimaryBgColor">#2B0841</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryBtnBgColor">#4F2472</SolidColorBrush>
        <LinearGradientBrush x:Key="PrimaryBgGradient" StartPoint="0% 0%" EndPoint="100% 0%" >
            <!--  <GradientStop Offset="0" Color="#04041f" />
            <GradientStop Offset="1" Color="#151e3e" /> -->
            <GradientStop Offset="0" Color="#2B0841" />
            <GradientStop Offset="1" Color="#48088C" />
        </LinearGradientBrush>
        <FontFamily x:Key="IconFont">
            avares://Client/Assets/Fonts/Phosphor/Phosphor.ttf#Phosphor
        </FontFamily>
        <FontFamily x:Key="HeaderFont">
            avares://Client/Assets/Fonts/Bebas_Neue/BebasNeue-Regular.ttf#Bebas Neue
        </FontFamily>
        <FontFamily x:Key="TextFont">
            avares://Client/Assets/Fonts/Advisor/AdvisorSSK.ttf#AdvisorSSK
        </FontFamily>


    </Application.Resources>
</Application>