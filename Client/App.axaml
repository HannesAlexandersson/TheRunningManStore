<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Client"
             x:Class="Client.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <!-- the global data template -->
        <local:ViewLocator>

        </local:ViewLocator>
    </Application.DataTemplates>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="Assets/Styles/AppStyles.axaml"></StyleInclude>
        <StyleInclude Source="Assets/Styles/MenuButtonStyles.axaml"></StyleInclude>
        <StyleInclude Source="Assets/Styles/FormButtonStyles.axaml"></StyleInclude>
        <StyleInclude Source="Assets/Styles/LabelStyles.axaml"></StyleInclude>
        <StyleInclude Source="Assets/Styles/TextBlockStyles.axaml"></StyleInclude>
        <StyleInclude Source="Assets/Styles/TextBoxStyles.axaml"></StyleInclude>

    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Assets/Resources/ColorsResources.axaml" /> <!-- colors must be read first or else the other resources wont find the colors-->
                <ResourceInclude Source="Assets/Resources/AppResources.axaml" /> <!-- resources like fonts etc -->
                <ResourceInclude Source="Assets/Resources/AppGradients.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>